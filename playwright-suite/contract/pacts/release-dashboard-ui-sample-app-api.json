{
  "consumer": {
    "name": "release-dashboard-ui"
  },
  "interactions": [
    {
      "description": "a request for dashboard metrics",
      "providerStates": [
        {
          "name": "metrics are available"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/metrics"
      },
      "response": {
        "body": {
          "apiHealth": "Green",
          "coverage": 82,
          "p95LatencyMs": 640
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "sample-app-api"
  }
}