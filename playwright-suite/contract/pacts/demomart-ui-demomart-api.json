{
  "consumer": {
    "name": "demomart-ui"
  },
  "interactions": [
    {
      "description": "a checkout request",
      "providerStates": [
        {
          "name": "the cart holds 2x prod-1"
        }
      ],
      "request": {
        "body": {
          "address": "1 Main St",
          "email": "ada@example.com",
          "name": "Ada",
          "payment": {
            "cardLast4": "4242"
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/orders"
      },
      "response": {
        "body": {
          "id": "ord-1",
          "items": [
            {
              "name": "Aurora Wireless Headphones",
              "price": 129.99,
              "productId": "prod-1",
              "qty": 2
            }
          ],
          "status": "confirmed",
          "total": 259.98
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            }
          }
        },
        "status": 201
      }
    },
    {
      "description": "a request for the product list",
      "providerStates": [
        {
          "name": "products are available"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/products"
      },
      "response": {
        "body": [
          {
            "category": "electronics",
            "description": "Over-ear Bluetooth headphones.",
            "id": "prod-1",
            "name": "Aurora Wireless Headphones",
            "price": 129.99,
            "rating": 4.5,
            "stock": 24
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].description": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to add prod-1 to the cart",
      "providerStates": [
        {
          "name": "product prod-1 exists"
        }
      ],
      "request": {
        "body": {
          "productId": "prod-1",
          "qty": 2
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/cart/items"
      },
      "response": {
        "body": {
          "items": [
            {
              "name": "Aurora Wireless Headphones",
              "price": 129.99,
              "productId": "prod-1",
              "qty": 2
            }
          ],
          "subtotal": 259.98
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "demomart-api"
  }
}