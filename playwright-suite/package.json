{
  "description": "Playwright + TypeScript UI test framework for the enterprise QA blueprint",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@pact-foundation/pact": "^17.1.4",
    "@playwright/test": "^1.64.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "allure-playwright": "^3.2.0",
    "typescript": "^7.0.2"
  },
  "name": "enterprise-qa-playwright-suite",
  "private": true,
  "scripts": {
    "report": "playwright show-report",
    "start": "node server.mjs",
    "test": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:browserstack": "playwright test --project=browserstack",
    "test:contract": "playwright test --config=playwright.contract.config.ts",
    "test:headed": "playwright test --headed --project=chromium",
    "test:mobile": "playwright test --grep @mobile",
    "test:smoke": "playwright test --grep @smoke",
    "baseline:update": "node scripts/update-baseline.mjs"
  },
  "version": "0.2.0"
}
