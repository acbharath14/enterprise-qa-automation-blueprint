{"info":{"description":"Hourly health check for the DemoMart sample store API. Run via Newman in CI.","name":"DemoMart API Health Check","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Returns product array', () => {","  const j = pm.response.json();","  pm.expect(j).to.be.an('array');","  pm.expect(j.length).to.be.above(0);","});","pm.test('Has prod-1', () => {","  pm.expect(pm.response.json().some(p => p.id === 'prod-1')).to.be.true;","});","pm.test('Response under 800ms', () => {","  pm.expect(pm.response.responseTime).to.be.below(800);","});"]}}],"name":"GET /api/products","request":{"method":"GET","url":{"host":["{{baseUrl}}"],"path":["api","products"],"raw":"{{baseUrl}}/api/products"}}},{"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Returns the headphone product', () => {","  pm.expect(pm.response.json().name).to.eql('Aurora Wireless Headphones');","});"]}}],"name":"GET /api/products/prod-1","request":{"method":"GET","url":{"host":["{{baseUrl}}"],"path":["api","products","prod-1"],"raw":"{{baseUrl}}/api/products/prod-1"}}},{"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Returns auth token', () => {","  const j = pm.response.json();","  pm.expect(j).to.have.property('token');","  pm.collectionVariables.set('authToken', j.token);","});"]}}],"name":"POST /api/login (valid)","request":{"body":{"mode":"raw","raw":"{\"username\": \"admin\", \"password\": \"secret\"}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":{"host":["{{baseUrl}}"],"path":["api","login"],"raw":"{{baseUrl}}/api/login"}}},{"event":[{"listen":"test","script":{"exec":["pm.test('Status is 401', () => pm.response.to.have.status(401));","pm.test('Error message present', () => {","  pm.expect(pm.response.json()).to.have.property('error');","});"]}}],"name":"POST /api/login (invalid)","request":{"body":{"mode":"raw","raw":"{\"username\": \"admin\", \"password\": \"wrong\"}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":{"host":["{{baseUrl}}"],"path":["api","login"],"raw":"{{baseUrl}}/api/login"}}},{"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Cart has subtotal', () => {","  pm.expect(pm.response.json().subtotal).to.be.a('number');","});"]}}],"name":"POST /api/cart/items","request":{"body":{"mode":"raw","raw":"{\"productId\": \"prod-1\", \"qty\": 1}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":{"host":["{{baseUrl}}"],"path":["api","cart","items"],"raw":"{{baseUrl}}/api/cart/items"}}},{"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Cart contains prod-1 line', () => {","  pm.expect(pm.response.json().items.some(i => i.productId === 'prod-1')).to.be.true;","});"]}}],"name":"GET /api/cart","request":{"method":"GET","url":{"host":["{{baseUrl}}"],"path":["api","cart"],"raw":"{{baseUrl}}/api/cart"}}},{"event":[{"listen":"test","script":{"exec":["pm.test('Status is 404', () => pm.response.to.have.status(404));","pm.test('JSON 404 shape', () => {","  pm.expect(pm.response.json()).to.have.property('error');","});","pm.test('Content-Type is JSON', () => {","  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');","});"]}}],"name":"GET /api/nope (404)","request":{"method":"GET","url":{"host":["{{baseUrl}}"],"path":["api","nope"],"raw":"{{baseUrl}}/api/nope"}}}],"variable":[{"key":"baseUrl","value":"http://localhost:4173"},{"key":"authToken","value":""}]}