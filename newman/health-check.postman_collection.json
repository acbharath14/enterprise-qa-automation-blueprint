{"info":{"description":"Hourly health check for the blueprint sample app API. Run via Newman in CI.","name":"Blueprint API Health Check","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Has coverage metric', () => {","  const j = pm.response.json();","  pm.expect(j).to.have.property('coverage');","  pm.expect(j.coverage).to.be.a('number');","});","pm.test('API health is Green', () => {","  pm.expect(pm.response.json().apiHealth).to.eql('Green');","});","pm.test('Response under 800ms', () => {","  pm.expect(pm.response.responseTime).to.be.below(800);","});"]}}],"name":"GET /api/metrics","request":{"method":"GET","url":{"host":["{{baseUrl}}"],"path":["api","metrics"],"raw":"{{baseUrl}}/api/metrics"}}},{"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Returns auth token', () => {","  const j = pm.response.json();","  pm.expect(j).to.have.property('token');","  pm.collectionVariables.set('authToken', j.token);","});"]}}],"name":"POST /api/login (valid)","request":{"body":{"mode":"raw","raw":"{\"username\": \"admin\", \"password\": \"secret\"}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":{"host":["{{baseUrl}}"],"path":["api","login"],"raw":"{{baseUrl}}/api/login"}}},{"event":[{"listen":"test","script":{"exec":["pm.test('Status is 401', () => pm.response.to.have.status(401));","pm.test('Error message present', () => {","  pm.expect(pm.response.json()).to.have.property('error');","});"]}}],"name":"POST /api/login (invalid)","request":{"body":{"mode":"raw","raw":"{\"username\": \"admin\", \"password\": \"wrong\"}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":{"host":["{{baseUrl}}"],"path":["api","login"],"raw":"{{baseUrl}}/api/login"}}},{"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Returns matching results', () => {","  const j = pm.response.json();","  pm.expect(j).to.be.an('array');","  pm.expect(j).to.include('Aurora');","});"]}}],"name":"GET /api/search","request":{"method":"GET","url":{"host":["{{baseUrl}}"],"path":["api","search"],"query":[{"key":"q","value":"aur"}],"raw":"{{baseUrl}}/api/search?q=aur"}}},{"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Returns feedback id', () => {","  pm.expect(pm.response.json()).to.have.property('id');","});"]}}],"name":"POST /api/feedback (valid)","request":{"body":{"mode":"raw","raw":"{\"name\": \"Newman\", \"email\": \"newman@health.check\"}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":{"host":["{{baseUrl}}"],"path":["api","feedback"],"raw":"{{baseUrl}}/api/feedback"}}},{"event":[{"listen":"test","script":{"exec":["pm.test('Status is 400', () => pm.response.to.have.status(400));"]}}],"name":"POST /api/feedback (invalid email)","request":{"body":{"mode":"raw","raw":"{\"name\": \"Newman\", \"email\": \"not-an-email\"}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":{"host":["{{baseUrl}}"],"path":["api","feedback"],"raw":"{{baseUrl}}/api/feedback"}}},{"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Returns CSV', () => {","  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv');","  pm.expect(pm.response.text()).to.include('release,coverage,status');","});"]}}],"name":"GET /api/export","request":{"method":"GET","url":{"host":["{{baseUrl}}"],"path":["api","export"],"raw":"{{baseUrl}}/api/export"}}}],"variable":[{"key":"baseUrl","value":"http://localhost:4173"},{"key":"authToken","value":""}]}